# Each machine keeps its own copy of your login (homework 3). Never
# commit one. Your factory should keep them out of Git too; this is a
# safety net.
**/machines/*/auth.json
**/machines/*/.credentials.json

# The reference factory binary that bin/get-reference-factory downloads.
bin/reference-factory

# yx yak tracker state
.yaks

# Generated from factory/stats/runs.jsonl by `make flow`.
factory/stats/flow.svg

# pi agent session artifacts
/.pi/
/factory/.pi/llm-metrics.log

/node_modules/
/target/

# Vim swap files
*.swp

# Neovim log files
.nvimlog
